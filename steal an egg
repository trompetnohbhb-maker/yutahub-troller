-- ====== ROOT PART & RANDOMIZE ======
local ROOT_PART_NAME = "skIUFIndfo83298J"
local randomizeNamesActive = false

local function getCharacterModel()
    return Workspace:FindFirstChild(Players.LocalPlayer.Name) or Players.LocalPlayer.Character
end

local function getRootPart()
    local charModel = getCharacterModel()
    local root = nil

    if charModel then
        local humanoid = charModel:FindFirstChildOfClass("Humanoid")
        if humanoid then
            root = humanoid.RootPart
        end
    end

    if not root then
        local char = Players.LocalPlayer.Character
        if char then
            root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild(ROOT_PART_NAME)
        end
    end

    return root
end

local function renameRootPart()
    local root = getRootPart()
    if root and root:IsA("Part") then
        root.Name = ROOT_PART_NAME
    end
end

Players.LocalPlayer.CharacterAdded:Connect(function()
    if randomizeNamesActive then
        renameRootPart()
    end
end)

-- God Mode sekali jalan: health 0, toggle randomize name on/off 4 detik
local function runGodModeOnce()
    task.spawn(function()
        local charModel = getCharacterModel()
        if not charModel then
            statusLabel:UpdateText("Status: Character model not found")
            return
        end
        local humanoid = charModel:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            statusLabel:UpdateText("Status: Humanoid not found")
            return
        end

        humanoid.Health = 0
        statusLabel:UpdateText("Status: Health reset, toggling randomize...")

        local start = tick()
        while (tick() - start) < 4 do
            randomizeNamesActive = true
            renameRootPart()
            task.wait(0.0)
            randomizeNamesActive = false
            task.wait(0.0)
        end
        randomizeNamesActive = false
        statusLabel:UpdateText("Status: Reset finished")
    end)
end

-- ====== FARM CEPAT (TELEPORT) DENGAN DELAY MODE ======
local farmDelay = 0.3
local farmActive = false
local farmLoop = nil

local function startFarm()
    if farmActive then return end
    if #selectedAreasOrdered == 0 then
        statusLabel:UpdateText("Status: Select at least 1 area!")
        return
    end

    local root = getRootPart()
    if not root then
        statusLabel:UpdateText("Status: Root part not found")
        return
    end

    farmActive = true

    farmLoop = task.spawn(function()
        while farmActive do
            cleanDebris()

            -- Cari telur sesuai prioritas area (tanpa rarity filter)
            local targetArea = nil
            local models = {}
            for _, area in ipairs(selectedAreasOrdered) do
                local areaModels = getModelsInArea(area)
                if #areaModels > 0 then
                    targetArea = area
                    models = areaModels
                    break
                end
            end

            if not targetArea then
                statusLabel:UpdateText("Status: No egg found, waiting...")
                task.wait(0.1)
                continue
            end

            local targetModel = models[math.random(1, #models)]
            local targetPos = targetModel:IsA("Model") and targetModel:GetPivot().Position or targetModel.Position

            -- Delay sebelum teleport ke egg
            task.wait(farmDelay)

            -- 1. TP ke telur
            root = getRootPart()
            if not root or not root.Parent then
                statusLabel:UpdateText("Status: Menunggu root part...")
                if notifMode == "1 notif" then
                    task.wait(0.3)
                else
                    task.wait(0.0)
                end
                continue
            end
            root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            statusLabel:UpdateText("Status: TP to " .. targetModel.Name .. " (" .. targetArea.name .. ")")

            -- Delay sebelum remote
            task.wait(0.2)

            -- 2. Tembak remote
            if remotePath then
                pcall(function()
                    remotePath:InvokeServer({ Uid = targetModel.Name })
                end)
                statusLabel:UpdateText("Status: Remote sent (" .. targetModel.Name .. ")")
            else
                statusLabel:UpdateText("Status: Remote not found!")
                break
            end

            -- Delay sebelum safe zone
            if notifMode == "2 notif" then
                task.wait(0.5)
            else
                task.wait(0.3)
            end

            -- 3. TP ke safe zone
            root = getRootPart()
            if root and root.Parent then
                root.CFrame = CFrame.new(Vector3.new(529.53, 70.57, -383.1))
                statusLabel:UpdateText("Status: Safe zone")
            end

            -- Delay setelah safe zone sebelum loop lagi
            task.wait(farmDelay)
            if not farmActive then break end
        end
        statusLabel:UpdateText("Status: Stopped.")
    end)
end

local function stopFarm()
    farmActive = false
    if farmLoop then
        pcall(function() task.cancel(farmLoop) end)
        farmLoop = nil
    end
end

YutaPremiumLib:CreateToggle(TabHome, "Start Auto Farm (Teleport)", function(state)
