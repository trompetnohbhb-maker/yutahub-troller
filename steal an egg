function YutaPremiumLib:CreateMultiSelectDropdown(tab, dropdownText, optionsTable, callback)
    local dropdown = {Opened = false, Checkboxes = {}, Options = optionsTable}
    local selected = {}
    local dropdownFrame = Instance.new("Frame")
    dropdownFrame.Size = UDim2.new(1, -28, 0, 42)
    dropdownFrame.BackgroundColor3 = Theme.ElementBg
    dropdownFrame.BackgroundTransparency = 0.2
    dropdownFrame.ClipsDescendants = true
    dropdownFrame.ZIndex = 4
    dropdownFrame.Parent = tab.PageScroll
    Instance.new("UICorner", dropdownFrame).CornerRadius = UDim.new(0, 8)
    local frameStroke = Instance.new("UIStroke")
    frameStroke.Color = Theme.Border
    frameStroke.Thickness = 1
    frameStroke.Parent = dropdownFrame
    local triggerBtn = Instance.new("TextButton")
    triggerBtn.Size = UDim2.new(1, 0, 0, 42)
    triggerBtn.BackgroundTransparency = 1
    triggerBtn.Text = "  " .. dropdownText .. " (0 selected) ▼"
    triggerBtn.TextColor3 = Theme.TextSecondary
    triggerBtn.Font = Enum.Font.GothamBold
    triggerBtn.TextSize = 12
    triggerBtn.TextXAlignment = Enum.TextXAlignment.Left
    triggerBtn.ZIndex = 5
    triggerBtn.AutoButtonColor = false
    triggerBtn.Parent = dropdownFrame
    dropdown.TriggerBtn = triggerBtn
    local listScroll = Instance.new("ScrollingFrame")
    listScroll.Size = UDim2.new(1, -16, 0, 0)
    listScroll.Position = UDim2.new(0, 8, 0, 46)
    listScroll.BackgroundColor3 = Theme.Sidebar
    listScroll.BackgroundTransparency = 0.3
    listScroll.BorderSizePixel = 0
    listScroll.ScrollBarThickness = 2
    listScroll.ScrollBarImageColor3 = Theme.BorderHover
    listScroll.ZIndex = 6
    listScroll.Visible = false
    listScroll.Parent = dropdownFrame
    dropdown.ListScroll = listScroll
    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 4)
    listLayout.Parent = listScroll
    local function updateSelectedText()
        local count = 0
        for _, v in pairs(selected) do if v then count = count + 1 end end
        triggerBtn.Text = "  " .. dropdownText .. " (" .. count .. " selected) ▼"
        if callback then callback(selected) end
    end
    local function rebuildOptions()
        for _, item in ipairs(dropdown.Checkboxes) do item.checkbox:Destroy() end
        table.clear(dropdown.Checkboxes)
        for _, optionName in ipairs(dropdown.Options) do
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, 0, 0, 28)
            row.BackgroundTransparency = 1
            row.Text = ""
            row.ZIndex = 7
            row.AutoButtonColor = false
            row.Parent = listScroll
            local checkbox = Instance.new("TextButton")
            checkbox.Size = UDim2.new(0, 18, 0, 18)
            checkbox.Position = UDim2.new(0, 6, 0.5, -9)
            checkbox.BackgroundColor3 = selected[optionName] and Theme.Accent or Color3.fromRGB(40, 40, 50)
            checkbox.Text = ""
            checkbox.ZIndex = 8
            checkbox.AutoButtonColor = false
            checkbox.Parent = row
            Instance.new("UICorner", checkbox).CornerRadius = UDim.new(0, 4)
            local checkMark = Instance.new("TextLabel")
            checkMark.Size = UDim2.new(1, 0, 1, 0)
            checkMark.BackgroundTransparency = 1
            checkMark.Text = "✓"
            checkMark.TextColor3 = Theme.TextMain
            checkMark.Font = Enum.Font.GothamBold
            checkMark.TextSize = 12
            checkMark.Visible = selected[optionName] and true or false
            checkMark.ZIndex = 9
            checkMark.Parent = checkbox
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -30, 1, 0)
            label.Position = UDim2.new(0, 28, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = optionName
            label.TextColor3 = Theme.TextSecondary
            label.Font = Enum.Font.Gotham
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.ZIndex = 8
            label.Parent = row
            row.MouseEnter:Connect(function() row.BackgroundColor3 = Theme.ElementHover end)
            row.MouseLeave:Connect(function() row.BackgroundColor3 = Color3.fromRGB(0,0,0) end)
            local function toggle()
                selected[optionName] = not selected[optionName]
                checkbox.BackgroundColor3 = selected[optionName] and Theme.Accent or Color3.fromRGB(40, 40, 50)
                checkMark.Visible = selected[optionName]
                updateSelectedText()
            end
            row.MouseButton1Click:Connect(toggle)
            checkbox.MouseButton1Click:Connect(toggle)
            table.insert(dropdown.Checkboxes, {checkbox = row})
        end
        listScroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
    end
    rebuildOptions()
    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        listScroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
    end)
    triggerBtn.MouseButton1Click:Connect(function()
        dropdown.Opened = not dropdown.Opened
        listScroll.Visible = dropdown.Opened
        if dropdown.Opened then
            local h = math.min(#dropdown.Options * 32 + 8, 160)
            listScroll.Size = UDim2.new(1, -16, 0, h)
            dropdownFrame.Size = UDim2.new(1, -28, 0, 42 + h + 8)
        else
            listScroll.Size = UDim2.new(1, -16, 0, 0)
            dropdownFrame.Size = UDim2.new(1, -28, 0, 42)
        end
    end)
    function dropdown:Refresh(newOptions)
        dropdown.Options = newOptions
        rebuildOptions()
        updateSelectedText()
    end
    return dropdown
end

