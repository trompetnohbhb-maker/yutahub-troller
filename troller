local Spamming = false
TrollSpamToggle.MouseButton1Click:Connect(function()
    Spamming = not Spamming
    if Spamming then
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: ON"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(0, 40, 20)
        TrollStroke.Color = Color3.fromRGB(0, 255, 100)
        
        task.spawn(function()
            while Spamming do
                pcall(function()
                    local ChatService = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents") and game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
                    local TextService = game:GetService("TextChatService")
                    
                    if TextService and TextService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local channel = TextService.TextChannels:FindFirstChild("RBXGeneral")
                        if channel then channel:SendAsync("YutaHub Troll On Top! 🚀") end
                    elseif ChatService then
                        ChatService:FireServer("YutaHub Troll On Top! 🚀", "All")
                    end
                end)
                task.wait(3.5)
            end
        end)
    else
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: OFF"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollStroke.Color = Color3.fromRGB(50, 50, 50)
    end
end)

-- B. ENGINE REAL FE SERVER-SIDED FLING (NYATA & MATI)
local FEFlingActive = false
local FlingHeartbeat = nil

TrollKillToggle.MouseButton1Click:Connect(function()
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if not RootPart or not Humanoid then return end
    
    FEFlingActive = not FEFlingActive
    if FEFlingActive then
        TrollKillToggle.Text = "REAL TOUCH FLING: ACTIVE"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(120, 0, 20)
        TrollKillStroke.Color = Color3.fromRGB(255, 0, 50)
        
        -- Memaksa server memvalidasi pergerakan fisik karakter Anda
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        
        FlingHeartbeat = RunService.Heartbeat:Connect(function()
            if not FEFlingActive or not RootPart.Parent or not Humanoid.Parent then
                if FlingHeartbeat then FlingHeartbeat:Disconnect() FlingHeartbeat = nil end
                return
            end
            
            -- Pertahankan pondasi koordinat agar di layar Anda tetap berjalan normal menapak tanah
            RootPart.CanCollide = true
            
            -- SUNTIKAN FORMULA SEGI EMPAT (SERVER-SIDED BYPASS):
            -- Kita mengubah nilai Velocity horizontal ke batas limit maksimum fisika mesin Roblox.
            -- Karena karakter ini adalah milik Anda, server WAJIB menerima data bahwa tubuh Anda sekeras peluru.
            -- Di layar Anda jalan biasa, tapi di server objek Anda bergetar secepat kilat menghancurkan musuh.
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 99999, 0) -- Putaran horizontal nyata yang merusak hitbox musuh
            
            -- Dorong paksa data paket ke server agar tidak terjadi delay visual pada musuh
            settings().Physics.AllowSleep = false
            settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnviromentalPhysicsThrottle.Disabled
        end)
    else
        TrollKillToggle.Text = "REAL TOUCH FLING: OFF"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollKillStroke.Color = Color3.fromRGB(50, 50, 50)
        
        if FlingHeartbeat then FlingHeartbeat:Disconnect() FlingHeartbeat = nil end
        pcall(function()
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end)

