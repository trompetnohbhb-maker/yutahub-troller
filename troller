        task.spawn(function()
            while Spamming do
                pcall(function()
                    local ChatService = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents") and game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
                    local TextService = game:GetService("TextChatService")
                    
                    if TextService and TextService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local channel = TextService.TextChannels:FindFirstChild("RBXGeneral")
                        if channel then channel:SendAsync("YutaHub Troll On Top! 🚀") end
                    elseif ChatService then
                        ChatService:FireServer("YutaHub Troll On Top! 🚀", "All")
                    end
                end)
                task.wait(3.5)
            end
        end)
    else
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: OFF"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollStroke.Color = Color3.fromRGB(50, 50, 50)
    end
end)

-- B. SCRIPT TOUCH FLING AURA (JALAN NORMAL, MUSUH MENYENTUH LANGSUNG MENTAL)
local FlingActive = false
local FlingConnection = nil
local HiddenPart = nil

TrollKillToggle.MouseButton1Click:Connect(function()
    local Character = LocalPlayer.Character
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    
    if not RootPart or not Humanoid then return end
    
    FlingActive = not FlingActive
    if FlingActive then
        TrollKillToggle.Text = "TOUCH FLING AURA: ACTIVE"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(120, 0, 20)
        TrollKillStroke.Color = Color3.fromRGB(255, 0, 50)
        
        -- Membuat Part tiruan tersembunyi khusus untuk menjadi peluru Fling (Hitbox Aura)
        HiddenPart = Instance.new("Part")
        HiddenPart.Name = "YutaAuraPart"
        HiddenPart.Size = Vector3.new(3.5, 3.5, 3.5) -- Ukuran area aura sentuh di sekeliling tubuh
        HiddenPart.Transparency = 1 -- Sepenuhnya transparan (Tidak terlihat orang lain)
        HiddenPart.CanCollide = false
        HiddenPart.Massless = true
        HiddenPart.Parent = Character
        
        -- Pasang jangkar virtual agar HiddenPart menempel dan mengikuti posisi pinggang/RootPart Anda
        local Attachment0 = Instance.new("Attachment", RootPart)
        local Attachment1 = Instance.new("Attachment", HiddenPart)
        local AlignPosition = Instance.new("AlignPosition")
        AlignPosition.Attachment0 = Attachment0
        AlignPosition.Attachment1 = Attachment1
        AlignPosition.MaxForce = 99999999
        AlignPosition.Responsiveness = 200
        AlignPosition.Parent = RootPart
        
        FlingConnection = RunService.Heartbeat:Connect(function()
            if not FlingActive or not Character.Parent or not HiddenPart.Parent then
                if FlingConnection then FlingConnection:Disconnect() FlingConnection = nil end
                return
            end
            
            -- Biarkan tubuh asli Anda jalan normal (CanCollide = True)
            RootPart.CanCollide = true
            
            -- Berikan pusaran daya hantam ekstrim HANYA pada Part tak terlihat (HiddenPart)
            -- Tubuh Anda 100% diam dan stabil, tetapi aura di sekitar Anda berputar mematikan
            HiddenPart.Velocity = Vector3.new(0, 0, 0)
            HiddenPart.RotVelocity = Vector3.new(99999, 99999, 99999)
        end)
    else
        TrollKillToggle.Text = "TOUCH FLING AURA: OFF"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollKillStroke.Color = Color3.fromRGB(50, 50, 50)
        
        if FlingConnection then FlingConnection:Disconnect() FlingConnection = nil end
        if HiddenPart then HiddenPart:Destroy() HiddenPart = nil end
        pcall(function()
            RootPart.RotVelocity = Vector3.new(0, 0, 0)
        end)
    end
end)

