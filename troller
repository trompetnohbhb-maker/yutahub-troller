-- ==========================================
--          A. LOGIKA FIX CHAT SPAMMER        
-- ==========================================
local Spamming = false
TrollSpamToggle.MouseButton1Click:Connect(function()
    Spamming = not Spamming
    if Spamming then
        -- [Visual UI Changes]
        task.spawn(function()
            while Spamming do
                pcall(function()
                    -- Sistem Baru: Mengirimkan teks lewat TextChatService
                    local TextChatService = game:GetService("TextChatService")
                    local ChatChannel = TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                    
                    if ChatChannel then
                        ChatChannel:SendAsync("YutaHub Troll On Top! 🚀")
                    else
                        game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer("YutaHub Troll On Top! 🚀", "All")
                    end
                end)
                task.wait(2.5) 
            end
        end)
    else
        -- [Visual UI Changes]
    end
end)

-- ==========================================
--          B. LOGIKA FIX FLING ANTI-BOUNCE   
-- ==========================================
local FlingActive = false
local FlingLoop = nil

TrollKillToggle.MouseButton1Click:Connect(function()
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if not RootPart or not Humanoid then return end
    
    FlingActive = not FlingActive
    if FlingActive then
        -- [Visual UI Changes]
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        
        FlingLoop = RunService.Heartbeat:Connect(function()
            if not FlingActive or not RootPart.Parent then 
                if FlingLoop then FlingLoop:Disconnect() end 
                return 
            end
            
            -- BYPASS STABILIZER: Memutar hanya koordinat Velocity secara matematis tanpa melempar model utama
            RootPart.Velocity = Vector3.new(0, -10, 0) -- Menempel erat ke lantai
            RootPart.RotVelocity = Vector3.new(0, 50000, 0) -- Berputar horizontal ekstrem ke musuh
            
            for _, Part in pairs(Character:GetChildren()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = false
                end
            end
        end)
    else
        -- [Visual UI Changes]
        if FlingLoop then FlingLoop:Disconnect() FlingLoop = nil end
        pcall(function()
            RootPart.Velocity = Vector3.new(0, 0, 0)
            RootPart.RotVelocity = Vector3.new(0, 0, 0)
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end)
