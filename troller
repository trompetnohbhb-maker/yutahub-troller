-- A. BYPASS CHAT SPAMMER EMULATOR
local Spamming = false
TrollSpamToggle.MouseButton1Click:Connect(function()
    Spamming = not Spamming
    if Spamming then
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: ON"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(0, 40, 20)
        TrollStroke.Color = Color3.fromRGB(0, 255, 100)
        
        task.spawn(function()
            while Spamming do
                pcall(function()
                    local ChatService = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents") and game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
                    local TextService = game:GetService("TextChatService")
                    
                    if TextService and TextService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local channel = TextService.TextChannels:FindFirstChild("RBXGeneral")
                        if channel then
                            channel:SendAsync("YutaHub Troll On Top! 🚀")
                        end
                    elseif ChatService then
                        ChatService:FireServer("YutaHub Troll On Top! 🚀", "All")
                    end
                end)
                task.wait(3.5)
            end
        end)
    else
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: OFF"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollStroke.Color = Color3.fromRGB(50, 50, 50)
    end
end)

-- B. BYPASS MONSTER FLING STABILIZER (METODE GHOST-FLING ANTI-KEMBALI KEPENTAL)
local FlingActive = false
local FlingConnection = nil

TrollKillToggle.MouseButton1Click:Connect(function()
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if not RootPart or not Humanoid then return end
    
    FlingActive = not FlingActive
    if FlingActive then
        TrollKillToggle.Text = "MONSTER FLING KILL: ON"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(120, 0, 20)
        TrollKillStroke.Color = Color3.fromRGB(255, 0, 50)
        
        -- Pertahankan status berdiri (Physics Mode) agar massa tubuh utuh membanting musuh
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        
        FlingConnection = RunService.PostSimulation:Connect(function()
            if not FlingActive or not RootPart.Parent or not Humanoid.Parent then
                if FlingConnection then FlingConnection:Disconnect() FlingConnection = nil end
                return
            end
            
            -- Matikan sistem tabrakan luar secara real-time
            for _, Part in pairs(Character:GetChildren()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = false
                end
            end
            
            -- GHOST FLING CORE: Kirim daya dorong linier searah sumbu horizontal X/Z secara konstan
            -- Server dipaksa membaca area hitbox kita menabrak semua koordinat musuh secara searah
            RootPart.AssemblyLinearVelocity = Vector3.new(99999, 0, 99999)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0) -- Kunci rotasi agar kamera Anda tetap lurus
        end)
    else
        TrollKillToggle.Text = "MONSTER FLING KILL: OFF"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollKillStroke.Color = Color3.fromRGB(50, 50, 50)
        
        if FlingConnection then FlingConnection:Disconnect() FlingConnection = nil end
        pcall(function()
            RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            
            for _, Part in pairs(Character:GetChildren()) do
                if Part:IsA("BasePart") then Part.CanCollide = true end
            end
        end)
    end
end)

