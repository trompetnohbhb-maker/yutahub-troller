-- A. Logika Aksi Spammer Chat Bawaan Roblox
local Spamming = false
TrollSpamToggle.MouseButton1Click:Connect(function()
    Spamming = not Spamming
    if Spamming then
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: ON"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(0, 40, 20)
        TrollStroke.Color = Color3.fromRGB(0, 255, 100)
        
        task.spawn(function()
            while Spamming do
                local TextChatService = game:GetService("TextChatService")
                if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                    TextChatService.TextChannels.RBXGeneral:SendAsync("YutaHub Troll On Top! 🚀")
                else
                    game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer("YutaHub Troll On Top! 🚀", "All")
                end
                task.wait(2)
            end
        end)
    else
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: OFF"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollStroke.Color = Color3.fromRGB(50, 50, 50)
    end
end)

-- B. Logika Aksi Fling Kill (Bypass Filtering Enabled)
local FlingActive = false
local FlingBodyThrust = nil

TrollKillToggle.MouseButton1Click:Connect(function()
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if not RootPart or not Humanoid then return end
    
    FlingActive = not FlingActive
    if FlingActive then
        TrollKillToggle.Text = "MONSTER FLING KILL: ACTIVE"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(120, 0, 20)
        TrollKillStroke.Color = Color3.fromRGB(255, 0, 50)
        
        -- Menyuntikkan daya rotasi paksa berkecepatan ekstrim
        FlingBodyThrust = Instance.new("BodyThrust")
        FlingBodyThrust.Force = Vector3.new(999999, 0, 999999)
        FlingBodyThrust.Location = RootPart.Position
        FlingBodyThrust.Parent = RootPart
        
        -- Loop bypass tabrakan objek map agar pergerakan tembus tidak mental
        task.spawn(function()
            while FlingActive do
                pcall(function()
                    for _, Part in pairs(Character:GetChildren()) do
                        if Part:IsA("BasePart") then
                            Part.CanCollide = false
                        end
                    end
                end)
                task.wait()
            end
        end)
    else
        TrollKillToggle.Text = "MONSTER FLING KILL: OFF"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollKillStroke.Color = Color3.fromRGB(50, 50, 50)
        
        if FlingBodyThrust then 
            FlingBodyThrust:Destroy() 
            FlingBodyThrust = nil 
        end
        pcall(function()
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end)

