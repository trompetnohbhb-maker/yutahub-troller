-- A. CHAT SPAMMER BYPASS
local Spamming = false
TrollSpamToggle.MouseButton1Click:Connect(function()
    Spamming = not Spamming
    if Spamming then
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: ON"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(0, 40, 20)
        TrollStroke.Color = Color3.fromRGB(0, 255, 100)
        
        task.spawn(function()
            while Spamming do
                pcall(function()
                    local ChatService = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents") and game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
                    local TextService = game:GetService("TextChatService")
                    
                    if TextService and TextService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local channel = TextService.TextChannels:FindFirstChild("RBXGeneral")
                        if channel then channel:SendAsync("YutaHub Troll On Top! 🚀") end
                    elseif ChatService then
                        ChatService:FireServer("YutaHub Troll On Top! 🚀", "All")
                    end
                end)
                task.wait(3.5)
            end
        end)
    else
        TrollSpamToggle.Text = "TROLL CHAT SPAMMER: OFF"
        TrollSpamToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollStroke.Color = Color3.fromRGB(50, 50, 50)
    end
end)

-- B. REAL INVISIBLE FLING ENGINE (100% SAMA SEPERTI EXPLOITER LAIN)
local FlingActive = false
local LoopConn = nil

TrollKillToggle.MouseButton1Click:Connect(function()
    local Char = LocalPlayer.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")
    
    if not Root or not Hum then return end
    
    FlingActive = not FlingActive
    if FlingActive then
        TrollKillToggle.Text = "INVISIBLE FLING: ACTIVE"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(120, 0, 20)
        TrollKillStroke.Color = Color3.fromRGB(255, 0, 50)
        
        -- Glitch Sendi Fisika (Membuat Tubuh Klien Lepas dari Validasi Anti-Cheat)
        local T_Clone = Root:Clone()
        T_Clone.Parent = Char
        Root:Destroy() -- Menghancurkan koneksi jangkar asli agar Anda kebal pentalan balik
        LocalPlayer.Character = nil
        LocalPlayer.Character = Char
        task.wait(0.2)
        
        LoopConn = RunService.Heartbeat:Connect(function()
            if not FlingActive or not T_Clone.Parent or not Hum.Parent then
                if LoopConn then LoopConn:Disconnect() LoopConn = nil end
                return
            end
            
            -- Mematikan sistem tabrakan dinding agar tidak mental menembus batas map
            for _, v in pairs(Char:GetChildren()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
            
            -- Menembakkan gaya hantam jutaan km/jam secara berputar melingkar di koordinat server
            T_Clone.Velocity = Vector3.new(0, 0, 0)
            T_Clone.RotVelocity = Vector3.new(99999, 99999, 99999)
            
            -- Kamera otomatis melayang stabil mengikuti pergerakan kursor mouse/HP
            local MoveDir = Hum.MoveDirection
            if MoveDir.Magnitude > 0 then
                T_Clone.Position = T_Clone.Position + (MoveDir * 1.5)
            end
        end)
    else
        TrollKillToggle.Text = "REAL INVISIBLE FLING: OFF"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollKillStroke.Color = Color3.fromRGB(50, 50, 50)
        
        if LoopConn then LoopConn:Disconnect() LoopConn = nil end
        -- Paksa karakter Reset/Respawn kembali normal setelah mematikan fitur
        if Hum then Hum:BreakJoints() end 
    end
end)

