end)

-- B. ENGINE REAL FE BACON HAIR FLING (NO-BLINK & SERVER-SIDED REAL KILL)
local HatFlingActive = false
local HatConnection = nil

TrollKillToggle.MouseButton1Click:Connect(function()
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if not RootPart or not Humanoid then return end
    
    HatFlingActive = not HatFlingActive
    if HatFlingActive then
        HatFlingActive = true
        TrollKillToggle.Text = "BACON FLING: ACTIVE"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(120, 0, 20)
        TrollKillStroke.Color = Color3.fromRGB(255, 0, 50)
        
        -- Deteksi khusus untuk mencari model rambut Pal Hair (Bacon) Anda
        local BaconHair = Character:FindFirstChild("PalHair") or Character:FindFirstChildOfClass("Accessory")
        local Handle = BaconHair and BaconHair:FindFirstChild("Handle")
        
        if Handle then
            -- Cari dan hancurkan las penyambung rambut agar terlepas bebas
            for _, Weld in pairs(Handle:GetDescendants()) do
                if Weld:IsA("Weld") or Weld:IsA("ManualWeld") or Weld:IsA("WeldConstraint") then
                    Weld:Destroy()
                end
            end
            
            HatConnection = RunService.Heartbeat:Connect(function()
                if not HatFlingActive or not RootPart.Parent or not Handle.Parent then
                    if HatConnection then HatConnection:Disconnect() HatConnection = nil end
                    return
                end
                
                -- Karakter utama dikunci agar CanCollide bernilai true (Anti-Bergetar / Anti-Blink)
                RootPart.CanCollide = true
                
                pcall(function()
                    -- Bebaskan rambut dari tabrakan dinding agar bisa menyatu masuk ke hitbox musuh
                    Handle.CanCollide = false
                    
                    -- Pindahkan rambut melayang horizontal melingkar tepat di sekitar tubuh Anda
                    Handle.CFrame = RootPart.CFrame * CFrame.new(0, -0.5, 0) * CFrame.Angles(math.rad(tick()*450), math.rad(tick()*450), 0)
                    
                    -- Tembakkan energi putaran fisik limit penuh pada rambut Bacon Anda
                    Handle.Velocity = Vector3.new(0, 0, 0)
                    Handle.RotVelocity = Vector3.new(99999, 99999, 99999)
                end)
                
                settings().Physics.AllowSleep = false
            end)
        else
            -- Proteksi jika rambut terlepas sebelum script dinyalakan
            HatFlingActive = false
            TrollKillToggle.Text = "BACON FLING AURA: OFF"
            TrollKillToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            TrollKillStroke.Color = Color3.fromRGB(50, 50, 50)
        end
    else
        TrollKillToggle.Text = "BACON FLING AURA: OFF"
        TrollKillToggle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TrollKillStroke.Color = Color3.fromRGB(50, 50, 50)
        
        if HatConnection then HatConnection:Disconnect() HatConnection = nil end
        -- Otomatis respawn hidup kembali untuk merapikan susunan rambut setelah dipakai bertanding
        if Humanoid then Humanoid:BreakJoints() end
    end
end)

